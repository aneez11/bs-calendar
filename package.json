{
  "name": "nepali-bs-calendar",
  "version": "0.2.1",
  "type": "module",
  "description": "Zero-dependency Nepali Bikram Sambat (BS) calendar conversion",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aneez11/bs-calendar.git"
  },
  "homepage": "https://github.com/aneez11/bs-calendar#readme",
  "bugs": {
    "url": "https://github.com/aneez11/bs-calendar/issues"
  },
  "author": "aneez11 (https://github.com/aneez11)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/calendar.d.ts",
      "import": "./dist/react/calendar.js",
      "require": "./dist/react/calendar.cjs"
    },
    "./date-picker": {
      "types": "./dist/react/date-picker.d.ts",
      "import": "./dist/react/date-picker.js",
      "require": "./dist/react/date-picker.cjs"
    }
  },
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "build": "tsup",
    "test": "vitest run",
    "verify:data": "tsx scripts/verify-data.ts",
    "ci": "npm run build:data && npm run verify:data && npm run build && npm test",
    "prepublishOnly": "npm run build:data && npm run verify:data && npm run build && npm test",
    "serve:docs": "npx serve docs -l 4000"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "nepali",
    "nepali-calendar",
    "calendar",
    "bikram-sambat",
    "bikram",
    "sambat",
    "bs",
    "bs-calendar",
    "patro",
    "nepali-patro",
    "date-converter",
    "ad-to-bs",
    "bs-to-ad",
    "nepali-date",
    "nepal",
    "react-calendar",
    "date-picker",
    "datepicker",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT"
}
